{
  "name": "nextjs-obsidian-blog-kit",
  "version": "1.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "blog:setup": "bash scripts/setup.sh",
    "blog:doctor": "bash scripts/doctor.sh",
    "blog:update": "node scripts/blog-update.mjs",
    "blog:deploy": "bash scripts/deploy.sh prod",
    "blog:deploy:preview": "bash scripts/deploy.sh preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "!(.obsidian)/**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@radix-ui/colors": "^3.0.0",
    "@rehype-pretty/transformers": "^0.13.2",
    "@tailwindcss/postcss": "^4.1.8",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.25",
    "mermaid": "^12.0.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rss": "^1.2.2",
    "sharp": "^0.34.1",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.1.8",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "18.19.100",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/rss": "^0.0.32",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "typescript": "^5.8.2"
  }
}
